{
    "name": "mrgkanev/shipstation-shopify-checker",
    "description": "Shopify ↔ ShipStation order audit dashboard",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "guzzlehttp/guzzle": "^8.0",
        "vlucas/phpdotenv": "^5.6",
        "league/csv": "^9.28",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Shopify\\": "src/Shopify/"
        },
        "classmap": ["src/"],
        "exclude-from-classmap": ["src/Shopify/"],
        "files": ["src/ViewHelpers.php"]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "docs": "php bin/generate-tools-doc.php",
        "docs:check": "php bin/generate-tools-doc.php --check"
    },
    "extra": {
        "app-version": "2.1.0"
    },
    "config": {
        "optimize-autoloader": true
    }
}
